    "templates": [
      {
        "id": "post-file-save-tests",
        "title": "PostFileSave test runner",
        "eyebrow": "VERIFY ON SAVE",
        "description": "Run the project's standard-library tests after an agent saves a Python file.",
        "hook": {
          "name": "Test Python on save",
          "description": "Run tests after agent-edited Python files are saved.",
          "trigger": "PostFileSave",
          "matcher": "\\.py$",
          "action": {
            "type": "command",
            "command": "python -m unittest discover -s tests -v"
          },
          "timeout": 120,
          "enabled": true
        }
      },
      {
        "id": "pre-tool-use-guard",
        "title": "PreToolUse guard",
        "eyebrow": "PROTECT SECRETS",
        "description": "Block agent write tools when the requested path targets a .env file.",
        "hook": {
          "name": "Guard .env writes",
          "description": "Exit 2 to block writes to .env files before the tool executes.",
          "trigger": "PreToolUse",
          "matcher": "write",
          "action": {
            "type": "command",
            "command": "python -c \"import json,sys; e=json.load(sys.stdin); p=str(e.get('tool_input',{}).get('path','')).replace(chr(92),'/'); sys.exit(2 if p.endswith('.env') or '/.env' in p else 0)\""
          },
          "timeout": 10,
          "enabled": true
        }
      },
      {
        "id": "stop-test-gate",
        "title": "Stop test gate",
        "eyebrow": "CHECK BEFORE DONE",
        "description": "Run tests when the agent stops. Failures are reported; Stop itself cannot block completion.",
        "hook": {
          "name": "Test gate at stop",
          "description": "Run the test suite when the agent completes its turn.",
          "trigger": "Stop",
          "action": {
            "type": "command",
            "command": "python -m unittest discover -s tests -v"
          },
          "timeout": 120,
          "enabled": true
        }
      }
    ]
  },
